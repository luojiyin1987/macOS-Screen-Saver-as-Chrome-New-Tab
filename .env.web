# Web build mode (Cloudflare Pages website). Loaded via `pnpm run build:web`
# (`vite build --mode web`). Keep VITE_WEB_BUILD=true here — the extension
# build (`pnpm run build`) never reads this file.

VITE_WEB_BUILD=true

# OPTIONAL — the website defaults to the site's own origin, where the
# bundled Pages Functions serve /itunes-assets/* as the Apple proxy.
# Only set these if you host the proxy elsewhere:
# VITE_MACIFY_BASE=https://your-host.example.com
#
# Anti-abuse token (casual protection only — it is inlined in the public
# JS bundle, so treat it as a filter, not a secret):
#   - MUST equal the APPLE_PROXY_KEY secret you set in Pages settings.
#     A mismatch makes every video request return 403.
#   - For real protection, use a custom domain with WAF rules and rate
#     limiting, and watch /itunes-assets/* traffic in Pages analytics.
# VITE_APPLE_PROXY_KEY=your_random_hex_token
